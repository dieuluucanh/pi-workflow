{
  "lastChangelogVersion": "1.5.0",
  "theme": "dark",
  "packages": [
    "npm:pi-lens",
    "npm:pi-web-access",
    "npm:@plannotator/pi-extension",
    "npm:pi-memory",
    "npm:@dieulc/pi-office-protocol@0.3.0",
    "npm:@dieulc/pi-office-bridge@^0.6.0"
  ],
  "extensions": [
    "models.ts"
  ],
  "enabledModels": [
    "opencode-go/muse-spark-1.3-contributor",
    "opencode-go/deepseek-v4.1-flash",
    "synthetic/hf:deepseek-ai/DeepSeek-V4.1-Flash-1017",
    "synthetic/hf:zai-org/GLM-5.3-Flash",
    "opencode-go/beam-free",
    "opencode-go/mimo-v2.6-flash",
    "command-code/deepseek/deepseek-v4.1-flash"
  ],
  "defaultThinkingLevel": "high",
  "defaultProvider": "opencode-go",
  "defaultModel": "deepseek-v4.1-flash",
  "terminal": {
    "showTerminalProgress": true
  },
  "hideThinkingBlock": true,
  "enableInstallTelemetry": false,
  "doubleEscapeAction": "none",
  "workflow": {
    "reviewMode": {
      "enabled": true,
      "rounds": 1,
      "passes": 2,
      "verify": true,
      "fallbackOnError": "skip",
      "providerRecovery": "fallback",
      "providerRetries": 1,
      "chunkedSubmit": "auto",
      "chunkChars": 6000,
      "recoveryBudgetMs": 0,
      "exploreBudget": 3,
      "timeoutMs": 0,
      "contextChars": 15000,
      "contextEntries": 30,
      "contextToolChars": 1000
    },
    "writePolicy": {
      "mode": "allow",
      "allowedPaths": [],
      "allowedCommands": [
        "sed -n '260,340p' docs/multi_gpu.md",
        "sed -n '395,500p' docs/multi_gpu.md"
      ],
      "mutatingTools": []
    },
    "modelDefault": {
      "provider": "opencode-go",
      "id": "deepseek-v4.1-flash",
      "thinking": "high"
    },
    "defaultProfile": "Opencode-Deepseek-V4.1-Flash",
    "commitPolicy": {
      "mode": "never",
      "allowedPaths": []
    },
    "folderPolicy": {
      "mode": "any",
      "outside": "ask",
      "grantScope": "project",
      "sensitiveTemplates": "allow",
      "sensitivePatterns": [],
      "sensitiveExemptions": [],
      "excludePaths": [
        "C:/",
        "C:/Personal"
      ]
    },
    "handoff": {
      "mode": "plannotator"
    }
  },
  "extensionChangelogVersions": {
    "{\"source\":\"npm:pi-lens\",\"scope\":\"user\"}": "4.5.0",
    "{\"source\":\"npm:pi-web-access\",\"scope\":\"user\"}": "0.47.0",
    "{\"source\":\"npm:pi-memory\",\"scope\":\"user\"}": "0.4.2"
  }
}
