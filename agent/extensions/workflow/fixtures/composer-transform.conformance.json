{
  "version": 1,
  "contract": "composer-transform-v1",
  "note": "Byte-identical cross-repository conformance fixture for composer-transform-v1. Workflow publishes; Pi Desktop reads. Both independent validators must return the same accept/reject verdict and the same error code for every case. A contract change updates this file once and copies it verbatim to tests/shared/fixtures/composer-transform.conformance.json.",
  "limits": {
    "maxDraftTextChars": 262144,
    "maxExpandedTextChars": 524288,
    "maxCandidateTextChars": 262144,
    "maxAttachmentCount": 16,
    "maxAttachmentBytes": 10485760,
    "maxTotalAttachmentBytes": 20971520,
    "maxImageCount": 16,
    "maxAggregateFrameBytes": 33554432,
    "maxGrantChars": 160,
    "grantIdChars": 22,
    "grantSecretChars": 43,
    "grantTtlMs": 30000,
    "maxRendezvousClaims": 1,
    "maxRetainedReceipts": 64,
    "legacyContributionMaxArgsChars": 1000
  },
  "icons": [
    "sparkles",
    "wand",
    "refresh",
    "edit",
    "check",
    "close",
    "chevron-up",
    "chevron-down",
    "play",
    "pause",
    "stop",
    "alert"
  ],
  "behaviors": ["one-shot-return", "persistent"],
  "envelopes": [
    {
      "name": "composer-control is additive in contribution v1",
      "expect": "ok",
      "input": {
        "version": 1,
        "owner": { "id": "fixture.alpha", "version": "1.0.0" },
        "sessionId": "session-a",
        "epoch": 0,
        "revision": 1,
        "contributions": [
          {
            "id": "alpha-toggle",
            "kind": "action",
            "slot": "action",
            "label": "Toggle refine",
            "tone": "neutral",
            "order": 10,
            "command": { "name": "alpha-toggle" },
            "enabled": true
          },
          {
            "id": "alpha-transform",
            "kind": "action",
            "slot": "action",
            "label": "Refine draft",
            "tone": "neutral",
            "order": 11,
            "command": { "name": "alpha-refine" },
            "enabled": true
          },
          {
            "id": "alpha-composer",
            "kind": "composer-control",
            "slot": "composer-actions",
            "label": "Refine",
            "description": "Rewrite the current draft without sending it",
            "icon": "sparkles",
            "tone": "accent",
            "order": 12,
            "checked": false,
            "enabled": true,
            "behavior": "one-shot-return",
            "actionRef": "alpha-toggle",
            "transformActionRef": "alpha-transform",
            "operation": {
              "contract": "composer-transform-v1",
              "publicCommand": "alpha-refine",
              "companionCommand": "alpha-refine-companion"
            }
          }
        ]
      }
    },
    {
      "name": "unknown contribution kind is dropped, not fatal",
      "expect": "ok",
      "input": {
        "version": 1,
        "owner": { "id": "fixture.alpha" },
        "sessionId": "session-a",
        "epoch": 0,
        "revision": 1,
        "contributions": [
          { "kind": "hologram", "id": "future", "text": "from the future" },
          { "kind": "status", "id": "known", "text": "still renders" }
        ]
      }
    },
    {
      "name": "unknown contribution contract version is rejected",
      "expect": "error",
      "input": {
        "version": 2,
        "owner": { "id": "fixture.alpha" },
        "sessionId": "session-a",
        "epoch": 0,
        "revision": 1,
        "contributions": []
      }
    },
    {
      "name": "more than four composer controls is refused",
      "expect": "error",
      "input": {
        "version": 1,
        "owner": { "id": "fixture.alpha" },
        "sessionId": "session-a",
        "epoch": 0,
        "revision": 1,
        "contributions": [
          {
            "id": "c1",
            "kind": "composer-control",
            "label": "One",
            "behavior": "persistent",
            "actionRef": "a1",
            "transformActionRef": "t1",
            "operation": {
