              "companionCommand": "alpha-refine-companion"
            }
          },
          {
            "id": "c3",
            "kind": "composer-control",
            "label": "Three",
            "behavior": "persistent",
            "actionRef": "a3",
            "transformActionRef": "t3",
            "operation": {
              "contract": "composer-transform-v1",
