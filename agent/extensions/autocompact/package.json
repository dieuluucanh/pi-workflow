    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dieuluucanh/pi-workflow.git",
    "directory": "agent/extensions/autocompact"
  },
  "bugs": {
    "url": "https://github.com/dieuluucanh/pi-workflow/issues"
  },
  "homepage": "https://github.com/dieuluucanh/pi-workflow#readme",
  "pi": {
    "extensions": ["./extensions/autocompact.ts"]
  },
  "files": [
    "extensions/",
    "prompts/",
    "summarizer.ts",
    "trigger.ts",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {},
