  "type": "module",
  "private": false,
  "keywords": ["pi-package", "workflow", "autocompact", "pi-workflow", "dotfiles"],
  "description": "Portable Pi dotfiles — workflow + autocompact + sane defaults. Clone to ~/.pi or pi install.",
